{
    "name": "umanit/sylius-product-variant-attribute-plugin",
    "type": "sylius-plugin",
    "keywords": ["sylius", "sylius-plugin"],
    "description": "Plugin for Sylius to add attributes on product variants.",
    "license": "MIT",
    "scripts": {
        "test": "vendor/bin/phpspec run",
        "analyse": "vendor/bin/phpstan analyse",
        "lint": "vendor/bin/ecs"
    },
    "scripts-descriptions": {
        "test": "Run phpspec tests",
        "analyse": "Run PHPStan",
        "lint": "Run ECS linter"
    },
    "require": {
        "php": "^7.4 || ^8.0",
        "sylius/sylius": "~1.10.14"
    },
    "require-dev": {
        "mockery/mockery": "^1.6.12",
        "phpspec/phpspec": "^7.6",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "sylius-labs/coding-standard": "^4.4",
        "symfony/debug-bundle": "^4.4 || ^5.4.45",
        "symfony/dotenv": "^4.4 || ^5.4.48",
        "symfony/web-profiler-bundle": "^4.4 || ^5.4.48"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "symfony/thanks": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.10-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "Tests\\Umanit\\SyliusProductVariantAttributePlugin\\": ["tests/", "tests/Application/src"],
            "Umanit\\SyliusProductVariantAttributePlugin\\": "src/",
            "Umanit\\SyliusProductVariantAttributePlugin\\spec\\": "spec/"
        }
    },
    "autoload-dev": {
        "classmap": ["tests/Application/Kernel.php"]
    },
    "archive": {
        "exclude": [
            "/.ddev/",
            "/.vscode/",
            "/etc/",
            "/spec/",
            "/tests/",
            "/vendor/",
            "/.gitattributes",
            "/.gitignore",
            "/ecs.php",
            "/phpspec.yml"
        ]
    }
}
