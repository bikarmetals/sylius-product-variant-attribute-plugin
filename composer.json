{
    "name": "umanit/sylius-product-variant-attribute-plugin",
    "type": "sylius-plugin",
    "keywords": ["sylius", "sylius-plugin"],
    "description": "Plugin for Sylius to add attributes on product variants.",
    "license": "MIT",
    "require": {
        "php": "^7.4 || ^8.0",
        "sylius/sylius": "~1.10.14"
    },
    "require-dev": {
        "mockery/mockery": "^1.6.12",
        "phpspec/phpspec": "^7.6",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan": "0.12.85",
        "phpstan/phpstan-doctrine": "0.12.33",
        "phpstan/phpstan-strict-rules": "^0.12.10",
        "phpstan/phpstan-webmozart-assert": "0.12.12",
        "sensiolabs/security-checker": "^6.0.3",
        "sylius-labs/coding-standard": "^4.4.1",
        "symfony/browser-kit": "^4.4 || ^5.4.45",
        "symfony/debug-bundle": "^4.4 || ^5.4.45",
        "symfony/dotenv": "^4.4 || ^5.4.48",
        "symfony/intl": "^4.4 || ^5.4.47",
        "symfony/web-profiler-bundle": "^4.4 || ^5.4.48"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "symfony/thanks": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.10-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "Tests\\Umanit\\SyliusProductVariantAttributePlugin\\": ["tests/", "tests/Application/src"],
            "Umanit\\SyliusProductVariantAttributePlugin\\": "src/",
            "Umanit\\SyliusProductVariantAttributePlugin\\spec\\": "spec/"
        }
    },
    "autoload-dev": {
        "classmap": ["tests/Application/Kernel.php"]
    },
    "archive": {
        "exclude": [
            "/.ddev/",
            "/.vscode/",
            "/etc/",
            "/spec/",
            "/tests/",
            "/vendor/",
            "/.env.local",
            "/.gitattributes",
            "/.gitignore",
            "/easy-coding-standard.yml",
            "/phpspec.yml"
        ]
    }
}
