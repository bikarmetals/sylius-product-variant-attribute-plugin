{
    "name": "umanit/sylius-product-variant-attribute-plugin",
    "type": "sylius-plugin",
    "keywords": ["sylius", "sylius-plugin"],
    "description": "Plugin for Sylius to add attributes on product variants.",
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "sylius/sylius": "~1.12.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpspec/phpspec": "^8.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "sylius-labs/coding-standard": "^4.4",
        "symfony/debug-bundle": "^6.0",
        "symfony/dotenv": "^6.0",
        "symfony/web-profiler-bundle": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "Tests\\Umanit\\SyliusProductVariantAttributePlugin\\": ["tests/", "tests/Application/src"],
            "Umanit\\SyliusProductVariantAttributePlugin\\": "src/",
            "Umanit\\SyliusProductVariantAttributePlugin\\spec\\": "spec/"
        }
    },
    "autoload-dev": {
        "classmap": ["tests/Application/Kernel.php"]
    },
    "scripts": {
        "test": "vendor/bin/phpspec run",
        "analyse": "vendor/bin/phpstan analyse",
        "analyse:baseline": "vendor/bin/phpstan analyse --generate-baseline",
        "lint": "vendor/bin/ecs",
        "lint:fix": "vendor/bin/ecs --fix"
    },
    "scripts-descriptions": {
        "test": "Run phpspec tests",
        "analyse": "Run PHPStan",
        "analyse:baseline": "Generate PHPStan baseline",
        "lint": "Run ECS linter",
        "lint:fix": "Fix ECS linter errors"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "symfony/thanks": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.10-dev"
        }
    },
    "archive": {
        "exclude": [
            "/.ddev/",
            "/.git/",
            "/.vscode/",
            "/bin/",
            "/cypress/",
            "/etc/",
            "/node_modules/",
            "/spec/",
            "/tests/",
            "/vendor/",
            "/.editorconfig",
            "/.gitattributes",
            "/.gitignore",
            "/cypress.config.js",
            "/ecs.php",
            "/phpspec.yml",
            "/phpstan-baseline.neon",
            "/phpstan.neon"
        ]
    }
}
